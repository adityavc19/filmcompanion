# TMDB API key (server-only — never expose to client)
TMDB_API_KEY=your_tmdb_api_key

# Gemini API key (get from https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis for rate limiting (optional in dev — falls back to in-memory).
# Required for production: rate limits won't survive across serverless instances
# without a shared store. Either Upstash directly or Vercel KV (which is Upstash
# under the hood) works.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token
# Aliases — Vercel KV sets these automatically when you connect a KV store.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
